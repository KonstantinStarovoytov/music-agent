# LLM — primary: OpenAI (or Luna, an OpenAI-compatible gateway)
OPENAI_API_KEY=
# If using Luna or another OpenAI-compatible gateway, set its endpoint:
# OPENAI_BASE_URL=https://your-luna-endpoint/v1

# LLM fallbacks (free tiers)
GOOGLE_API_KEY=          # https://aistudio.google.com/apikey (Gemini free tier)
GROQ_API_KEY=            # https://console.groq.com/keys (Groq free tier)

# Langfuse (cloud free tier: https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Database — Supabase free tier (Postgres; pgvector is phase 2, not used yet)
# Project settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Music data APIs (all free)
LASTFM_API_KEY=          # https://www.last.fm/api/account/create
GETSONGBPM_API_KEY=      # https://getsongbpm.com/api
# Deezer needs no key. (MusicBrainz is a phase-2 fallback, not used yet.)
